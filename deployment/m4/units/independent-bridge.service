[Unit]
Description=Nonprivileged independent bridge and authenticated Web
After=daed-api.service bridge-attestor.service bridge-helper.socket
Requires=bridge-helper.socket
[Service]
User=independent-bridge
Group=independent-bridge
ExecStart=/usr/bin/python3 -I /usr/local/bin/bridge-web
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=
ReadWritePaths=/var/lib/bridge-m4-client /var/lib/daed-independent-bridge/inbox
[Install]
WantedBy=multi-user.target
