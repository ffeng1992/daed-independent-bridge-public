{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "status": {
          "const": "converted"
        },
        "candidate": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "enum": [
            "not-run",
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "candidate",
        "sha256",
        "diagnostics",
        "validation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "status": {
          "const": "rejected"
        },
        "candidate": {
          "type": "null"
        },
        "sha256": {
          "type": "null"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "validation": {
          "const": "not-run"
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "candidate",
        "sha256",
        "diagnostics",
        "validation"
      ],
      "additionalProperties": false
    }
  ]
}
