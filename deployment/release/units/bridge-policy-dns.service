[Unit]
Description=Independent bridge bridge-policy-dns DNS
After=network-online.target
[Service]
Type=simple
User=_dnsdist
Group=_dnsdist
ExecStart=/usr/bin/dnsdist --supervised --disable-syslog -C /etc/daed-independent-bridge/policy-dns.conf
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
[Install]
WantedBy=multi-user.target
