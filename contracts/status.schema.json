{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M2.1 real service status",
  "type": "object",
  "properties": {
    "activeBundle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestedBundle": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "matchesRequestedBundle": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "state": {
      "enum": [
        "stopped",
        "starting",
        "running",
        "reloading",
        "failed",
        "rollback-needed"
      ]
    },
    "MainPID": {
      "type": "integer",
      "minimum": 0
    },
    "InvocationID": {
      "type": "string",
      "pattern": "^([0-9a-f]{32})?$"
    },
    "executableSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "configSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "identityVerified": {
      "type": "boolean"
    },
    "systemd": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result": {
      "enum": [
        "RECOVERY_REQUIRED",
        "MANUAL_INTERVENTION_REQUIRED"
      ]
    },
    "phase": {
      "type": "string"
    },
    "error": {
      "enum": [
        "CURRENT_VERSION_INVALID",
        "UNIT_IDENTITY_MISMATCH"
      ]
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "activeBundle",
    "requestedBundle",
    "matchesRequestedBundle",
    "state",
    "MainPID",
    "InvocationID",
    "executableSha256",
    "configSha256",
    "identityVerified",
    "systemd"
  ],
  "additionalProperties": false
}
