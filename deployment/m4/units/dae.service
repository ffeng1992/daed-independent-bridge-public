[Unit]
Description=Official independent DAE dataplane
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=exec
ExecStart=/usr/bin/python3 -I /usr/local/bin/bridge-runner
ExecReload=/opt/bridge-service/dae reload $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15
LimitMEMLOCK=infinity
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
# Official DAE needs setns/unshare for its dedicated dataplane namespace.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE CAP_DAC_READ_SEARCH
ReadWritePaths=/sys/fs/bpf /run /var/lib/daed-independent-bridge
[Install]
WantedBy=multi-user.target
